{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Clear .next and node_modules",
			"type": "shell",
			"command": "rm -rf .next node_modules"
		},
		{
			"label": "🚀 Build App",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "🧹 Clean Build Cache (pwsh)",
			"type": "shell",
			"command": "Remove-Item -Recurse -Force .next; Remove-Item -Recurse -Force node_modules",
			"group": "build"
		},
		{
			"label": "📦 Install Dependencies (pwsh)",
			"type": "shell",
			"command": "npm install",
			"group": "build"
		}
	]
}